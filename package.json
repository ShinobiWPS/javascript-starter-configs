{
	"type": "module",
	"scripts": {
		"commitlint": "commitlint --edit",
		"lint": "oxlint --fix",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"deps": "pnpm dlx npm-check-updates@latest --interactive --format group",
		"knip:check": "knip --audit"
	},
	"devDependencies": {
		"@antfu/eslint-config": "2.6.4",
		"@biomejs/biome": "^1.5.1",
		"@commitlint/cli": "^18.4.4",
		"@commitlint/config-conventional": "^18.4.4",
		"@eslint-react/eslint-plugin": "^5.19.0",
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^1.5.4",
		"@tanstack/eslint-plugin-query": "^5.102.8",
		"@tanstack/eslint-plugin-router": "^1.162.0",
		"@typescript-eslint/eslint-plugin": "^6.18.1",
		"@typescript-eslint/parser": "^6.18.1",
		"eslint": "^10.10.0",
		"eslint-plugin-import": "^2.29.1",
		"eslint-plugin-jsx-a11y": "6.8.0",
		"eslint-plugin-oxlint": "^1.82.0",
		"eslint-plugin-react": "7.33.2",
		"eslint-plugin-react-hooks": "4.6.0",
		"eslint-plugin-react-refresh": "^0.4.5",
		"eslint-plugin-tailwindcss": "3.14.2",
		"knip": "6.16.1",
		"lint-staged": "^15.*",
		"oxlint": "^1.82.0",
		"oxlint-tsgolint": "^7.0.2001",
		"simple-git-hooks": "^2.9.0",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.70.0"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm run lint-staged",
		"pre-push": "echo 'Pre-push'",
		"commit-msg": "pnpm run commitlint ${1}"
	},
	"lint-staged": {
		"*.{js,jsx,tsx,ts,json,jsonc}": [
			"oxlint --fix"
		],
		"*.{js,jsx,ts,tsx,json,jsonc}": [
			"biome format --write"
		]
	}
}